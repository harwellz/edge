# Site configuration for docker compose. Copy to .env next to compose.yml
# and fill in; .env is gitignored and never leaves your machine.

# Your own relay and TURN (fork B1 cutover). Leave EDGE_RELAY_URL at the
# default to keep using the official upstream relay instead.
EDGE_RELAY_URL=wss://relay.example.com
EDGE_ICE_ALLOWLIST=turn:relay.example.com:3478?transport=udp,turn:relay.example.com:3478?transport=tcp

# Frigate authenticated port, when it is not reachable on loopback.
FRIGATE_AUTH_URL=https://192.0.2.10:8971
